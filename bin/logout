#!/bin/bash

# Define options
options=(
  "Power Off"
  "Reboot"
  "Lock"
  "Suspend"
  "Logout"
)

# Use vicinae dmenu to pick one
# --no-quick-look ensures it waits for you to press Enter
choice=$(printf "%s\n" "${options[@]}" | vicinae dmenu --placeholder "System Action:" --no-quick-look)

# Execute the command based on selection
case "$choice" in
"Power Off")
  systemctl poweroff
  ;;
"Reboot")
  systemctl reboot
  ;;
"Lock")
  # Using hyprlock as per your original script
  hyprlock
  ;;
"Suspend")
  systemctl suspend
  ;;
"Logout")
  # Specific to your Niri session
  pkill niri
  ;;
*)
  exit 0
  ;;
esac
