#!/usr/bin/env bash

# --- CONFIGURABLE PART ---
CHROME_BROWSERS=(
  "chromium"
  "brave"
  "google-chrome"
  "google-chrome-stable"
  "microsoft-edge-stable"
  "vivaldi"
  "opera"
)
# --------------------------

URL=""
EXTRA_ARGS=""

# 🔄 Parse Arguments (Handles flags and URL in any order)
while [[ $# -gt 0 ]]; do
  case $1 in
    --incognito)
      EXTRA_ARGS="--incognito"
      shift # Move to next argument
      ;;
    *)
      # If it's not a flag, assume it's the URL
      URL="$1"
      shift # Move to next argument
      ;;
  esac
done

# 🛑 Validation
if [ -z "$URL" ]; then
  echo "Usage: launch-webapp [--incognito] <url>"
  exit 1
fi

# 🔎 Detect Browser
WEBAPP_BROWSER=""
for BROWSER_EXE in "${CHROME_BROWSERS[@]}"; do
  if command -v "$BROWSER_EXE" &>/dev/null; then
    WEBAPP_BROWSER="$BROWSER_EXE"
    break
  fi
done

if [ -z "$WEBAPP_BROWSER" ]; then
  echo "Error: Could not find any supported Chromium-based browser."
  exit 1
fi

echo "Browser: $WEBAPP_BROWSER"
echo "URL:     $URL"
echo "Mode:    App Mode ${EXTRA_ARGS}"

# 🚀 Open Browser
# We inject $EXTRA_ARGS (which is empty or contains --incognito) before the app flag
"$WEBAPP_BROWSER" $EXTRA_ARGS --app="$URL" --enable-features=WindowControlsOverlay &
